                {
                    "expr": "histogram_quantile(0.50, sum(rate(dispatcher_lead_latency_seconds_bucket[5m])) by (le))",
                    "legendFormat": "P50: Lead Generation",
                    "refId": "D"
                },
                {
                    "expr": "histogram_quantile(0.50, sum(rate(ml_car_inference_latency_seconds_bucket[5m])) by (le))",
                    "legendFormat": "P50: ML Inference",
                    "refId": "E"
